{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!**/dist", "!**/node_modules"]
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "preset": "recommended",
        "useSortedAttributes": "off",
        "useSortedKeys": "off",
        "useSortedProperties": "on",
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [":ALIAS:", ":PACKAGE:"]
          }
        }
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "preset": "all",
        "noSvgWithoutTitle": "off"
      },
      "correctness": {
        "preset": "all",
        "noUnresolvedImports": "off",
        "noPrivateImports": "off",
        "noNodejsModules": "off",
        "useHookAtTopLevel": "off",
        "useJsonImportAttributes": "off",
        "useQwikValidLexicalScope": "off",
        "useImportExtensions": "off",
        "useImageSize": "off",
        "noSolidDestructuredProps": "off",
        "useUniqueElementIds": "off"
      },
      "performance": {
        "preset": "all",
        "noJsxPropsBind": "off",
        "noImgElement": "off",
        "useSolidForComponent": "off"
      },
      "security": {
        "preset": "all",
        "noSecrets": "off"
      },
      "suspicious": {
        "preset": "all",
        "noReactSpecificProps": "off",
        "noDeprecatedImports": "off",
        "noEmptyBlockStatements": "off",
        "noEqualsToNull": "off",
        "noForIn": "off",
        "noImportCycles": "warn",
        "noNestedPromises": "off",
        "noShadow": "off",
        "noUnnecessaryConditions": "warn",
        "noConsole": "off",
        "useAwait": "off"
      },
      "complexity": {
        "preset": "all",
        "noExcessiveLinesPerFunction": "off",
        "noUselessReturn": "off",
        "noImplicitCoercions": "off"
      },
      "style": {
        "preset": "all",
        "noTernary": "off",
        "noMagicNumbers": "off",
        "noNestedTernary": "off",
        "noProcessEnv": "off",
        "useExportsLast": "off",
        "noImplicitBoolean": "off",
        "noContinue": "off",
        "noExcessiveClassesPerFile": "off",
        "noExcessiveLinesPerFile": "off",
        "noEnum": "error",
        "noHexColors": "off",
        "noIncrementDecrement": "off",
        "noDefaultExport": "off",
        "noJsxLiterals": "off",
        "useDestructuring": "off",
        "useErrorCause": "off",
        "useGlobalThis": "off",
        "useReadonlyClassProperties": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "generic"
          }
        },
        "useConsistentMethodSignatures": {
          "level": "on",
          "options": {
            "style": "property"
          }
        },
        "useNamingConvention": {
          "level": "error",
          "options": {
            "requireAscii": true,
            "strictCase": true,
            "conventions": [
              {
                "selector": {
                  "kind": "typeLike"
                },
                "match": "[A-Z][a-zA-Z0-9]*(?:_[A-Z][a-zA-Z0-9]*)*",
                "formats": ["PascalCase"]
              },
              {
                "selector": {
                  "kind": "const",
                  "scope": "global"
                },
                "match": "[A-Z][a-zA-Z0-9]*(?:_[A-Z][a-zA-Z0-9]*)*|[A-Z][A-Z0-9_]*[A-Z0-9]|[a-z][a-zA-Z0-9]*",
                "formats": ["PascalCase", "CONSTANT_CASE", "camelCase"]
              }
            ]
          }
        },
        "useImportType": {
          "level": "error",
          "options": {
            "style": "separatedType"
          }
        }
      }
    },
    "domains": {
      "react": "all"
    }
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "formatWithErrors": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "attributePosition": "multiline",
    "bracketSpacing": true,
    "trailingNewline": true
  },
  "json": {
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  },
  "javascript": {
    "formatter": {
      "enabled": true,
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "asNeeded",
      "bracketSpacing": true,
      "bracketSameLine": true,
      "attributePosition": "multiline"
    },
    "linter": {
      "enabled": true
    }
  },
  "css": {
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    },
    "parser": {
      "tailwindDirectives": true
    }
  },
  "html": {
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/.storybook/**/*",
        "**/*.stories.*"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off",
            "noExcessiveCognitiveComplexity": "off"
          },
          "correctness": {
            "noNodejsModules": "off"
          },
          "security": {
            "noSecrets": "off"
          },
          "style": {
            "useComponentExportOnlyModules": "off"
          }
        }
      }
    },
    {
      "includes": ["src/domain/categories/**"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*-provider.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.d.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ]
}
